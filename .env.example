# Portal de Soporte BI — variables del servidor (no hay variables públicas).
# Copiar a .env.local para desarrollo. En Vercel se cargan en Settings → Environment Variables.
# Detalle de cada una y de cómo obtenerla: docs/DEPLOY.md

# Modo demo: datos ficticios y sesión simulada. SOLO desarrollo/preview.
# El build falla si DEMO_MODE=true y VERCEL_ENV=production.
# Con DEMO_MODE=true y las variables de Entra cargadas, además se puede probar el login real.
DEMO_MODE=true

# URL pública del portal, sin barra final (ej. https://soporte.bhiconsultora.com.ar).
APP_URL=http://localhost:3000

# Clave para cifrar la cookie de sesión (mín. 32 caracteres aleatorios).
# Generar con: bun -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Entra ID (tenant de BHI). Ver docs/DEPLOY.md §3.
# Credenciales: federación OIDC de Vercel (sin secretos). En local: `vercel link` + `vercel env pull`.
BHI_TENANT_ID=
PORTAL_CLIENT_ID=
DATA_CLIENT_ID=

# SharePoint: ID del sitio "Soporte BI" (formato host,siteId,webId)
SP_SITE_ID=

# Buzón desde el que se envían los correos (acotado por RBAC for Applications)
NOTIFY_MAILBOX=

# Opcional: webhook de Workflows de Teams para avisar tickets nuevos
TEAMS_WEBHOOK_URL=

# Secreto que Vercel Cron manda en Authorization: Bearer (mín. 16 caracteres)
CRON_SECRET=

# Opcional: activa el triage automático por API de Anthropic al crear tickets
ANTHROPIC_API_KEY=

# Opcional: segundos de caché del rol por usuario (0–300). Por defecto 120; en demo 0.
ACCESO_CACHE_SEGUNDOS=
