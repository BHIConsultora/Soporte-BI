# Portal de Soporte BI — variables públicas del frontend (Vite).
# Todo lo que empieza con VITE_ termina en el bundle del navegador: nunca poner secretos acá.
# Copiar a .env.local para desarrollo. Detalle: docs/DEPLOY.md

# Modo demo: datos ficticios y sesión simulada, sin Supabase. Solo desarrollo/preview.
# El build falla si VITE_DEMO_MODE=true y además está VITE_SUPABASE_URL.
VITE_DEMO_MODE=true

# Supabase (Lovable Cloud). Lovable las carga solo al conectar el backend.
# La clave publicable es pública por diseño: la seguridad está en RLS (supabase/migrations/).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
